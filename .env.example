# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Discord: create an application at https://discord.com/developers/applications
# Keep real credentials only in the ignored .env file.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Local infrastructure. Docker Compose exposes these ports when available.
DATABASE_URL="postgresql://postgres:discord_saas@localhost:5433/discord_saas?schema=public"
REDIS_URL="redis://localhost:6379"

# HTTP API
API_HOST=127.0.0.1
API_PORT=3001

# Local-only storage abstraction (relative to repository root)
STORAGE_ROOT=./storage
