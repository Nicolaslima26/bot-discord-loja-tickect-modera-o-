generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Module {
  STORE
  TICKETS
  MODERATION
}

enum GuildRole {
  OWNER
  ADMIN
  MODERATOR
  SUPPORT
  SELLER
}

enum TicketStatus {
  OPEN
  CLOSED
}

model Guild {
  id            String              @id // Discord guild snowflake
  name          String
  isConfigured  Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  modules       GuildModule[]
  memberships   GuildMembership[]
  auditLogs     AuditLog[]
  ticketConfig  TicketConfig?
  tickets       Ticket[]

  @@index([createdAt])
}

model TicketConfig {
  guildId          String   @id
  panelChannelId   String
  supportRoleId    String
  categoryId       String?
  maxOpenPerUser   Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String       @id @default(cuid())
  guildId     String
  channelId   String       @unique
  openerId    String
  sequence    Int
  status      TicketStatus @default(OPEN)
  closedAt    DateTime?
  closedById  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // A ticket sequence is meaningful only inside a tenant.
  @@unique([guildId, sequence])
  @@index([guildId, openerId, status])
  @@index([guildId, status, createdAt])
}

model GuildModule {
  id        String   @id @default(cuid())
  guildId   String
  module    Module
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Unique per guild guarantees that authorization never falls back to global state.
  @@unique([guildId, module])
  @@index([guildId, enabled])
}

model GuildMembership {
  id        String    @id @default(cuid())
  guildId   String
  userId    String    // Discord user snowflake
  role      GuildRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, role])
}

model AuditLog {
  id        String   @id @default(cuid())
  guildId   String
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}
