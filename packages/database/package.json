{
  "name": "@discord-saas/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate --schema ../../prisma/schema.prisma",
    "migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev --schema ../../prisma/schema.prisma",
    "studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio --schema ../../prisma/schema.prisma"
  },
  "dependencies": { "@prisma/client": "^6.0.0", "prisma": "^6.0.0" },
  "devDependencies": { "typescript": "^5.0.0" }
}
